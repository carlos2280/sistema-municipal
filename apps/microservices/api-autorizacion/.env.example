# ============================================
# API Autorizacion - Variables de Entorno (Template)
# ============================================
# SENSIBLE - Maneja permisos y roles
# Copia este archivo a .env y configura los valores
# ============================================

# Server
PORT=3003
NODE_ENV=development

# Database - Credenciales
DB_USER=postgres
DB_PASSWORD=your-secure-password
DB_HOST=localhost
DB_PORT=5434
DB_NAME=muni_default
DB_SSL=false

# Connection pool
DB_POOL_MIN=1
DB_POOL_MAX=10

# JWT - Debe coincidir con api-identidad
JWT_SECRET=same-as-api-identidad-jwt-secret
JWT_SECRET_TEMP=temp-secret-dev
JWT_EXPIRES_IN=1h
JWT_ISSUER=sistema-municipal

# Platform DB (multi-tenant)
PLATFORM_DB_NAME=platform

# MFA — clave AES-256-GCM (debe coincidir con api-identidad en el mismo entorno)
# Generar con: openssl rand -hex 32
MFA_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# Email (SMTP — Mailhog en dev, SMTP real en prod)
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_FROM=no-reply@sistema-municipal.cl
# SMTP_USER=
# SMTP_PASS=

# Resend (alternativa a SMTP, opcional)
# RESEND_API_KEY=

# URL publica del frontend (para armar links en emails)
APP_URL=http://localhost:5030

# Logging (debug, info, warn, error)
LOG_LEVEL=info
