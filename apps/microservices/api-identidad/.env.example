# ============================================
# API Identidad - Variables de Entorno (Template)
# ============================================
# ALTAMENTE SENSIBLE - Solo acceso equipo core
# Copia este archivo a .env y configura los valores
# ============================================

# Server
PORT=3001
NODE_ENV=development

# Database - Credenciales
DB_USER=postgres
DB_PASSWORD=your-secure-password
DB_HOST=localhost
DB_PORT=5434
DB_NAME=muni_default
DB_SSL=false

# Connection pool
DB_POOL_MIN=1
DB_POOL_MAX=10

# JWT
JWT_SECRET_TEMP=generate-secure-random-string

# MFA — Clave AES-256-GCM para cifrar secretos TOTP (32 bytes = 64 hex chars)
# Generar con: openssl rand -hex 32
# OBLIGATORIA en produccion — nunca reutilizar entre entornos
MFA_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
