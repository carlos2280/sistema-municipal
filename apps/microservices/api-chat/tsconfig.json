{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    /* api-chat usa NodeNext para compatibilidad con ESM nativo y extensiones .js en imports */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@controllers/*": ["./src/controllers/*"],
      "@services/*": ["./src/services/*"],
      "@routes/*": ["./src/routes/*"],
      "@socket/*": ["./src/socket/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
