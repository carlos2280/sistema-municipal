# Server
PORT=3004
NODE_ENV=development

# Database principal: DB transversal (schema mensajeria)
DATABASE_URL_TRANSVERSAL=postgresql://postgres:postgres@localhost:5434/transversal

# Microservicios internos
IDENTIDAD_SERVICE_URL=http://localhost:3001

# JWT (mismo secret que api-identidad)
JWT_SECRET=your-jwt-secret-key

# CORS
CORS_ORIGIN=http://localhost:5030

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# LiveKit (videollamadas)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Redis (presencia y sockets)
REDIS_URL=redis://localhost:6380

# Platform (para validar suscripcion al modulo chat)
PLATFORM_URL=http://localhost:3006
