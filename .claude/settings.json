{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push origin *)",
      "Bash(git checkout *)",
      "Bash(git stash *)",
      "Bash(npx drizzle-kit:*)",
      "Bash(npx @biomejs/biome check *)",
      "Bash(find /home/carlos/projects/sistema-municipal/apps/admin-panel/src -type f \\\\\\(-name *.tsx -o -name *.ts -o -name *.json \\\\\\))",
      "Bash(find /home/carlos/projects/sistema-municipal -name *THEME* -o -name *theme* -o -name *DESIGN*)",
      "Bash(find /home/carlos/projects/sistema-municipal/documentacion -name *.md -o -name *.css)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(sudo *)",
      "Bash(* drizzle-kit migrate:reset *)",
      "Bash(* drizzle-kit drop *)",
      "Bash(pnpm --filter * exec drizzle-kit drop *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/validate-security.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/check-deep-imports.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/auto-format.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
